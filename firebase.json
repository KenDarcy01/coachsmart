{
  "hosting": [
    {
      "target": "main",
      "public": "website",
      "ignore": ["firebase.json", "**/.*"],
      "rewrites": [
        { "source": "/lotto/**", "destination": "/lotto/index.html" }
      ],
      "headers": [
        {
          "regex": "^/clontarf-gaa/(results|season-review).*",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache" }
          ]
        },
        {
          "source": "/clontarf-gaa/feile27/**",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "/webviews/**",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
            { "key": "Pragma", "value": "no-cache" },
            { "key": "Expires", "value": "0" }
          ]
        }
      ]
    },
    {
      "target": "website-alt",
      "public": "website-alt",
      "ignore": ["firebase.json", "**/.*"]
    },
    {
      "target": "dosclontarf",
      "public": "dosclontarf",
      "ignore": ["firebase.json", "**/.*"]
    }
  ]
}
